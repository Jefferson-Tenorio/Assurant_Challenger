{
  "name": "outbox-connector-us", 
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    
    "_comment_auth": "Alinhado com o docker-compose (admin/admin)",
    "database.hostname": "postgres-us",        
    "database.port": "5432",                   
    "database.user": "admin",
    "database.password": "admin",
    "database.dbname": "insurance_core_us",
    
    "_comment_routing": "Prefixo US garante que eventos não se misturem no Kafka",
    "topic.prefix": "us.core",                 
    "plugin.name": "pgoutput",
    
    "publication.name": "dbz_outbox_pub",
    "table.include.list": "sys.transactional_outbox",
    
    "tombstones.on.delete": "false",
    "decimal.handling.mode": "double",
    
    "_comment_avro": "Apontando para o Registry LOCAL dos EUA (Isolamento)",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://redpanda-us:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://redpanda-us:8081",
    
    "_comment_heartbeat": "Query Otimizada para evitar Table Bloat",
    "heartbeat.interval.ms": "5000",
    "heartbeat.action.query": "INSERT INTO sys.heartbeat (id, ts) VALUES (1, NOW()) ON CONFLICT (id) DO UPDATE SET ts=EXCLUDED.ts;",

    "# --- TRANSFORMAÇÃO OUTBOX (SMT) ---": "Essencial para desencapsular o evento",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.topic.replacement":"br.core.${routedByValue}",
    "transforms.outbox.route.by.field": "aggregate_type"
  }
}
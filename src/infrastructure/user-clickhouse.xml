<clickhouse>
    <users>
        <!-- Definição do usuário Admin -->
        <admin>
            <password>admin123</password>
            <networks>
                <ip>::/0</ip> <!-- Aceita conexão de qualquer lugar -->
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <!-- CRUCIAL: Permite criar outros usuários e alterar configurações -->
            <access_management>1</access_management>
        </admin>
    </users>

    <!-- Ajustes de Perfil para Stress Test -->
    <profiles>
        <default>
            <!-- Permite usar toda a memória disponível no container se necessário -->
            <max_memory_usage>0</max_memory_usage>
            <!-- Permite queries pesadas sem timeout rápido -->
            <max_execution_time>300</max_execution_time>
        </default>
    </profiles>
</clickhouse>